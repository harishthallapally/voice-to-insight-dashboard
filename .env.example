OPENAI_API_KEY=your_openai_api_key
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_MODE=translate
OPENAI_TRANSCRIPTION_LANGUAGE=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
EXTRACTION_CHUNK_CHAR_LIMIT=12000
TRANSCRIPTION_WORKER_CONCURRENCY=4
BACKGROUND_JOB_RETENTION_HOURS=24
DASHBOARD_DEMO_MODE=false
# Metrics recording (uploads, driver counts, NPS) is written to Azure Cosmos
# only when NODE_ENV=production (a real `next build && next start`
# deployment). Local `next dev` runs never record, so local testing never
# writes into shared Cosmos data. Set to true/false to override either way.
DASHBOARD_METRICS_ENABLED=
# Set to true to also record metrics to a local JSON file
# (.local-metrics/events.json, gitignored) instead of/alongside Azure.
# Independent of DASHBOARD_METRICS_ENABLED above — off by default everywhere.
DASHBOARD_LOCAL_METRICS_ENABLED=
# Which store the dashboard reads from: "azure" (default) or "local".
DASHBOARD_METRICS_SOURCE=azure

AZURE_COSMOS_ENDPOINT=https://connect-nps-signup-uat.documents.azure.com:443/
AZURE_COSMOS_DATABASE_ID=connect-nps-db
AZURE_COSMOS_CONTAINER_ID=users
AZURE_COSMOS_METRICS_CONTAINER_ID=dashboard-metrics
AZURE_COSMOS_ORGANIZATION_ID=tvs
AZURE_COSMOS_KEY=your_cosmos_db_key_keep_secret

# --- OneDrive / SharePoint sync (Microsoft Graph, client-credentials flow) ---
# Azure app registration with the APPLICATION permission Files.ReadWrite.All,
# granted admin consent. See ONEDRIVE_SETUP.md for the portal steps.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=

# Which drive to talk to. Set exactly one, in order of preference:
#   ONEDRIVE_DRIVE_ID  - the drive id straight from Graph (most direct)
#   ONEDRIVE_USER_ID   - a user's UPN/object id; uses that user's OneDrive
#   ONEDRIVE_SITE_ID   - a SharePoint site id; uses its default document library
ONEDRIVE_DRIVE_ID=
ONEDRIVE_USER_ID=
ONEDRIVE_SITE_ID=

# Drive-relative paths (no leading slash needed).
ONEDRIVE_AUDIO_FOLDER=NPS/Audio
ONEDRIVE_WORKBOOK_PATH=NPS/nps-call-data.xlsx

# Optional: move each audio file here once processed. Leave blank to leave the
# audio in place (re-runs skip it anyway via the Source File column).
ONEDRIVE_PROCESSED_FOLDER=

# Optional shared secret for /api/onedrive/sync. Blank leaves the route open.
ONEDRIVE_SYNC_TOKEN=
